{
  "name": "@campus/backend",
  "version": "1.2.4",
  "description": "Campus Köthen API and canteen synchronization worker",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Leviora Studio and Jona Loreen Sommer",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "worker": "node dist/worker.js",
    "worker:dev": "ts-node -r tsconfig-paths/register src/worker.ts",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "seed:canteens": "ts-node -r tsconfig-paths/register src/cli/seed-canteens.ts",
    "seed:user-test-data": "ts-node -r tsconfig-paths/register src/cli/seed-user-test-data.ts",
    "sync:canteens": "ts-node -r tsconfig-paths/register src/cli/sync-canteens.ts",
    "sync:timetable": "ts-node -r tsconfig-paths/register src/cli/sync-timetable.ts",
    "openapi:generate": "ts-node -r tsconfig-paths/register src/cli/generate-openapi.ts"
  },
  "dependencies": {
    "@campus/map": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "compression": "1.8.2",
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "ical.js": "2.2.1",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.6",
    "@types/compression": "1.8.1",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.1.0",
    "jest": "^30.2.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1",
      "^test/(.*)$": "<rootDir>/test/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/generated/**",
      "!src/**/*.module.ts"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/src/generated/"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "maxWorkers": 1
  }
}
