# Campus Köthen — Campus API and worker environment template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# NEVER commit a filled-in file, and never put a real password in here.
#
# Every variable below is validated once at boot by src/config/env.schema.ts.
# An invalid value fails the process immediately and reports the offending KEY
# only — never the value, so a malformed DATABASE_URL cannot print a password
# into the logs.

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Explicit origin allowlist. A wildcard is REJECTED when NODE_ENV=production.
CORS_ALLOWED_ORIGINS=http://localhost:3021

# Swagger UI at /docs and the document at /docs-json.
# Unset means: on outside production, OFF when NODE_ENV=production — a
# conservative code default, because the page is real HTML under a looser CSP
# than the API on the same origin.
# This project deliberately overrides that and serves /docs in production too
# (see infrastructure/vps/compose.yaml): the API is a public read-only contract.
DOCS_ENABLED=true

LOG_LEVEL=info
# Pretty console output for humans; JSON is the default and the server format.
LOG_PRETTY=false

# IANA timezone used to evaluate every worker cron expression. UTC is the
# application fallback when this variable is omitted.
WORKER_TIME_ZONE=UTC

# Guard for the synthetic user-test data CLI and its global app disclosure.
# Enable only on a controlled, temporary DEV deployment.
USER_TEST_DATA_ENABLED=false

# --- Database ---------------------------------------------------------------
# The OPERATIONAL database only. Strapi has its own database and its own role;
# this connection can never reach it.
DATABASE_URL=postgresql://campus_app:REPLACE_ME@127.0.0.1:5433/campus_app_local?schema=public

# Used ONLY by `prisma migrate dev` locally. The application role is
# deliberately not a superuser and cannot create databases, so the shadow
# database is provisioned up front by infrastructure/local/initdb.
# `prisma migrate deploy`, which runs on the server, never uses one.
SHADOW_DATABASE_URL=postgresql://campus_app:REPLACE_ME@127.0.0.1:5433/campus_app_shadow?schema=public

# --- Strapi (editorial content) ---------------------------------------------
# The CMS address is never a source constant. Switching DEV/PROD changes this
# value and nothing else.
STRAPI_BASE_URL=http://127.0.0.1:1337
# Server-side READ-ONLY token, created in the Strapi admin UI. May stay empty
# until it exists; /health/ready then reports strapi as "not_configured",
# which is the honest signal rather than a hidden failure.
STRAPI_API_TOKEN=
STRAPI_TIMEOUT_MS=10000
STRAPI_RETRY_ATTEMPTS=2

# --- Canteen (meine-mensa.de) -----------------------------------------------
CANTEEN_SOURCE_URL=https://meine-mensa.de/api/food_plans
CANTEEN_HTTP_TIMEOUT_MS=15000
CANTEEN_RETRY_ATTEMPTS=3
# Largest source response we buffer. Enforced while reading, not afterwards.
CANTEEN_MAX_RESPONSE_BYTES=8000000
CANTEEN_REQUEST_SPACING_MS=1000
CANTEEN_SYNC_CRON="0 */2 * * *"
CANTEEN_SYNC_ON_BOOT=true
CANTEEN_STALE_AFTER_MINUTES=240
CANTEEN_SYNC_DAYS_AHEAD=14

# --- Timetable (public WebUntis view) ---------------------------------------
# OFF by default. The source is an internal interface of a third party's public
# web UI and automated use is not cleared yet — see docs/data-sources.md.
# Turn this on only as a deliberate decision.
WEBUNTIS_ENABLED=false
WEBUNTIS_BASE_URL=https://hsa.webuntis.com/WebUntis/api/rest/view/v1
# Identifies the tenant for the anonymous public view. Not a credential, but
# still server-side configuration: it must never reach the app.
WEBUNTIS_ANONYMOUS_SCHOOL=hsa
WEBUNTIS_HTTP_TIMEOUT_MS=20000
WEBUNTIS_RETRY_ATTEMPTS=3
WEBUNTIS_REQUEST_SPACING_MS=1500
WEBUNTIS_MAX_RESPONSE_BYTES=16000000
# The public view requires one request per class. Run the catalogue and
# full timetable daily, with enough time between their scheduled starts.
WEBUNTIS_GROUP_SYNC_CRON="0 2 * * *"
WEBUNTIS_ENTRY_SYNC_CRON="15 2 * * *"
WEBUNTIS_SYNC_ON_BOOT=true
WEBUNTIS_LOOKBACK_DAYS=7
WEBUNTIS_LOOKAHEAD_DAYS=28
WEBUNTIS_STALE_AFTER_MINUTES=1800

# --- Public Google calendars (public ICS feed) -----------------------------
# OFF by default. No Google API key / OAuth / service account exists or is
# needed: the worker downloads the PUBLIC ICS feed directly. Editors add
# calendars in Strapi; the worker validates the share link, derives the
# calendar id and constructs the fixed feed URL itself.
PUBLIC_CALENDAR_ENABLED=false
PUBLIC_CALENDAR_HTTP_TIMEOUT_MS=20000
PUBLIC_CALENDAR_RETRY_ATTEMPTS=2
PUBLIC_CALENDAR_REQUEST_SPACING_MS=1000
PUBLIC_CALENDAR_CATALOG_SYNC_CRON="*/10 * * * *"
PUBLIC_CALENDAR_EVENT_SYNC_CRON="*/10 * * * *"
PUBLIC_CALENDAR_SYNC_ON_BOOT=true
PUBLIC_CALENDAR_MAX_FEED_BYTES=8000000
PUBLIC_CALENDAR_MAX_EVENTS=5000
PUBLIC_CALENDAR_MAX_OCCURRENCES=10000
PUBLIC_CALENDAR_MAX_OCCURRENCES_PER_EVENT=750
PUBLIC_CALENDAR_MAX_SCANNED_OCCURRENCES=250000
PUBLIC_CALENDAR_MAX_TEXT_LENGTH=2000
PUBLIC_CALENDAR_LOOKBACK_DAYS=30
PUBLIC_CALENDAR_LOOKAHEAD_DAYS=180
PUBLIC_CALENDAR_STALE_AFTER_MINUTES=720
PUBLIC_CALENDAR_FALLBACK_TIME_ZONE=Europe/Berlin
# User-Agent of the feed download. Deployments may append their own API
# address as a contact, e.g. "CampusKoethen (+https://<your-api-host>)".
PUBLIC_CALENDAR_USER_AGENT="CampusKoethen"
PUBLIC_CALENDAR_API_MAX_CALENDARS=50
PUBLIC_CALENDAR_API_MAX_RANGE_DAYS=120
# Calendars and date range are bounded, the number of events they span is not.
# Reaching this ceiling is reported as meta.truncated, never silently cut.
PUBLIC_CALENDAR_API_MAX_EVENTS=2000
