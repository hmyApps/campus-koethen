# Campus Köthen — Strapi CMS environment template
#
# Copy to `.env` and fill in real values. NEVER commit a filled-in `.env`.
# Generate every secret yourself, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=1337
# Public URL Strapi is reached under. Required behind a reverse proxy: it
# becomes Strapi's `server.url`, and while it is set Strapi also trusts the
# proxy's X-Forwarded-* headers (`server.proxy.koa`).
# PUBLIC_URL=https://cms-dev.<domain>
# Optional explicit override for trusting X-Forwarded-* headers. Defaults to
# true when PUBLIC_URL is set and to false otherwise.
# IS_PROXIED=

# Explicit comma-separated browser origin allowlist for the CMS.
#
# Strapi's own default is `origin: '*'` with credentials enabled, and its
# wildcard branch REFLECTS the caller's Origin — which is the form browsers
# accept. Left empty, this project falls back to PUBLIC_URL (the origin the
# admin panel is served from) instead; with neither set, production allows no
# cross-origin caller at all rather than falling back to something permissive.
# A wildcard is refused outright when NODE_ENV=production (AGENTS.md §3).
CORS_ALLOWED_ORIGINS=

# --- Secrets (generate unique values per environment) ------------------------
# Two or more comma-separated keys.
APP_KEYS=REPLACE_ME_KEY_1,REPLACE_ME_KEY_2
API_TOKEN_SALT=REPLACE_ME
ADMIN_JWT_SECRET=REPLACE_ME
TRANSFER_TOKEN_SALT=REPLACE_ME
ENCRYPTION_KEY=REPLACE_ME

# --- Database ---------------------------------------------------------------
# The CMS uses its OWN database and its OWN role, separate from the app database.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=campus_cms_local
DATABASE_USERNAME=campus_cms
DATABASE_PASSWORD=REPLACE_ME
DATABASE_SSL=false
DATABASE_SCHEMA=public

# --- Internationalisation ---------------------------------------------------
# Default locale of the CMS. Content is maintained in `de` and `en`.
STRAPI_DEFAULT_LOCALE=de

# --- Seeding ----------------------------------------------------------------
# Set to `true` to allow the idempotent development seed to run.
SEED_DEMO_CONTENT=false

# Largest single media upload, in bytes. Unset means the Strapi default of 1 GB
# per file against a volume with no quota — an editor could fill the disk.
UPLOAD_SIZE_LIMIT_BYTES=26214400

