{
  "kind": "collectionType",
  "collectionName": "contact_areas",
  "info": {
    "singularName": "contact-area",
    "pluralName": "contact-areas",
    "displayName": "Contact Area",
    "description": "A functional point of contact (e.g. a student council or service centre). An area is valid and fully usable WITHOUT any contact person."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 120,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 120,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "shortDescription": {
      "type": "text",
      "required": true,
      "maxLength": 300,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "address": {
      "type": "text",
      "maxLength": 400,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "openingHours": {
      "type": "text",
      "maxLength": 400,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "iconKey": {
      "type": "enumeration",
      "enum": [
        "campus",
        "faculty",
        "students-council",
        "service",
        "library",
        "canteen",
        "housing",
        "finance",
        "international",
        "health",
        "sports",
        "it",
        "career"
      ],
      "required": true,
      "default": "service",
      "description": "Select the category icon shown for this contact area in the app.",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "site": {
      "type": "enumeration",
      "enum": ["koethen", "bernburg", "dessau"],
      "required": true,
      "default": "koethen",
      "description": "Campus site this contact area belongs to. The app lists the reader's own site first. Areas saved before this field existed count as Köthen.",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "generalEmail": {
      "type": "email",
      "maxLength": 200,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "phone": {
      "type": "string",
      "maxLength": 60,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "website": {
      "type": "string",
      "maxLength": 500,
      "regex": "^https://",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "appointmentBookingUrl": {
      "type": "string",
      "maxLength": 500,
      "regex": "^https://",
      "description": "Optional HTTPS link where users can book an appointment with this contact area.",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "persons": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::contact-person.contact-person",
      "inversedBy": "areas"
    },
    "rooms": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::room.room",
      "inversedBy": "contactAreas",
      "description": "Optional. Zero rooms is a normal, fully supported state.",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
