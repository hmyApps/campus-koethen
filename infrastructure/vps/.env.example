# Portable Campus Koethen VPS deployment
# Copy this file to `.env`, fill every empty credential, and run:
#   docker compose config --quiet
# Never commit the resulting `.env`.

# --- Compose and published images -------------------------------------------
COMPOSE_PROJECT_NAME=campus-koethen
CONTAINER_PLATFORM=linux/amd64
RESTART_POLICY=unless-stopped
DOCKER_LOG_MAX_SIZE=4m
DOCKER_LOG_MAX_FILES=1

CMS_IMAGE_REPOSITORY=ghcr.io/leviora-studio/campus-koethen/cms
BACKEND_IMAGE_REPOSITORY=ghcr.io/leviora-studio/campus-koethen/backend

# Not a credential. Set the immutable `sha-<full commit SHA>` tag from a
# successful GitHub Actions run. CMS and backend deliberately use the same tag.
CAMPUS_IMAGE_TAG=

# --- Public addresses and host bindings ------------------------------------
# Full HTTPS URLs served by the host's external reverse proxy.
CMS_PUBLIC_URL=https://cms.example.org
API_PUBLIC_URL=https://api.example.org

# Bind application ports to loopback so only the host reverse proxy can reach
# them. Do not change these to 0.0.0.0 on a public VPS.
CMS_BIND_ADDRESS=127.0.0.1
CMS_HOST_PORT=3020
CMS_CONTAINER_PORT=1337
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=3021
API_CONTAINER_PORT=3000

# Exact comma-separated browser origins allowed to call the API. Native iOS
# and Android clients do not use browser CORS. Never use `*` in production.
CORS_ALLOWED_ORIGINS=https://app.example.org

# Swagger UI at /docs. Empty means OFF here, because NODE_ENV=production.
DOCS_ENABLED=true

# The same list for the CMS admin, if it differs. Left empty, the CMS allows
# exactly its own CMS_PUBLIC_URL — the origin the admin panel is served from.
# Never use `*`; the CMS refuses one when NODE_ENV=production.
CMS_CORS_ALLOWED_ORIGINS=

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_CONTAINER_PORT=5432
POSTGRES_ADMIN_USERNAME=campus_admin
POSTGRES_ADMIN_DATABASE=postgres

# Credential: generate once with `openssl rand -hex 32`. Keep it stable for an
# existing volume; changing this file alone does not rotate PostgreSQL's admin
# password inside an already initialized database.
POSTGRES_ADMIN_PASSWORD=

CMS_DATABASE_NAME=campus_cms
CMS_DATABASE_USERNAME=campus_cms
CMS_DATABASE_SCHEMA=public

# Credential: generate with `openssl rand -hex 32`. A hex value is intentional
# because database passwords are also embedded into a PostgreSQL URL.
CMS_DATABASE_PASSWORD=

APP_DATABASE_NAME=campus_app
APP_DATABASE_USERNAME=campus_app
APP_DATABASE_SCHEMA=public

# Credential: generate with `openssl rand -hex 32`. If another generator is
# used, URL-reserved characters must be percent-encoded for DATABASE_URL.
APP_DATABASE_PASSWORD=

# --- Strapi -----------------------------------------------------------------
BACKEND_STRAPI_BASE_URL=http://cms:1337
STRAPI_DEFAULT_LOCALE=de
STRAPI_TELEMETRY_DISABLED=true
SEED_DEMO_CONTENT=false

# Largest single media upload, in bytes. Unset means the Strapi default of 1 GB
# per file against a volume with no quota — an editor could fill the disk.
UPLOAD_SIZE_LIMIT_BYTES=26214400

CMS_DATABASE_POOL_MIN=2
CMS_DATABASE_POOL_MAX=10
CMS_DATABASE_CONNECTION_TIMEOUT=60000

# Credentials: generate four independent values with `openssl rand -hex 32`
# and enter them comma-separated. Never reuse keys from another environment.
STRAPI_APP_KEYS=

# Credential: generate once with `openssl rand -hex 32`.
STRAPI_API_TOKEN_SALT=

# Credential: generate once with `openssl rand -hex 32`.
STRAPI_ADMIN_JWT_SECRET=

# Credential: generate once with `openssl rand -hex 32`.
STRAPI_TRANSFER_TOKEN_SALT=

# Credential: generate once with `openssl rand -hex 32`.
STRAPI_ENCRYPTION_KEY=

# Credential: leave empty only for the first CMS bootstrap. Afterwards create
# a read-only API token in Strapi Admin and place the token here. Strapi has no
# unauthenticated content API.
STRAPI_API_TOKEN=
STRAPI_TIMEOUT_MS=10000
STRAPI_RETRY_ATTEMPTS=2

# Valid IANA timezone used to evaluate every worker cron expression. If this
# value is omitted entirely, the backend falls back to UTC.
WORKER_TIME_ZONE=UTC

# Explicitly enables the synthetic dataset CLI and the mandatory global app
# disclosure. Keep false outside a temporary, controlled user-test deployment.
USER_TEST_DATA_ENABLED=false

# --- Canteen ---------------------------------------------------------------
CANTEEN_SOURCE_URL=https://meine-mensa.de/api/food_plans
CANTEEN_HTTP_TIMEOUT_MS=15000
CANTEEN_RETRY_ATTEMPTS=3
# Largest source response we buffer. Enforced while reading, not afterwards.
CANTEEN_MAX_RESPONSE_BYTES=8000000
CANTEEN_REQUEST_SPACING_MS=1000
CANTEEN_SYNC_CRON="0 */2 * * *"
CANTEEN_SYNC_ON_BOOT=true
CANTEEN_STALE_AFTER_MINUTES=240
CANTEEN_SYNC_DAYS_AHEAD=14

# --- WebUntis --------------------------------------------------------------
# Keep disabled until automated use of the selected upstream is deliberately
# cleared for the deployment. The school identifier is not a credential.
WEBUNTIS_ENABLED=false
WEBUNTIS_BASE_URL=https://example.webuntis.com/WebUntis/api/rest/view/v1
WEBUNTIS_ANONYMOUS_SCHOOL=example
WEBUNTIS_HTTP_TIMEOUT_MS=20000
WEBUNTIS_RETRY_ATTEMPTS=3
WEBUNTIS_REQUEST_SPACING_MS=1500
WEBUNTIS_MAX_RESPONSE_BYTES=16000000
WEBUNTIS_GROUP_SYNC_CRON="0 * * * *"
WEBUNTIS_ENTRY_SYNC_CRON="0 * * * *"
WEBUNTIS_SYNC_ON_BOOT=true
WEBUNTIS_LOOKBACK_DAYS=7
WEBUNTIS_LOOKAHEAD_DAYS=28
WEBUNTIS_STALE_AFTER_MINUTES=180

# --- Public ICS calendars --------------------------------------------------
# No Google API key or OAuth credential is used. Public calendar definitions
# are maintained in Strapi and read by the worker as public ICS feeds.
PUBLIC_CALENDAR_ENABLED=false
PUBLIC_CALENDAR_HTTP_TIMEOUT_MS=20000
PUBLIC_CALENDAR_RETRY_ATTEMPTS=2
PUBLIC_CALENDAR_REQUEST_SPACING_MS=1000
PUBLIC_CALENDAR_CATALOG_SYNC_CRON="*/10 * * * *"
PUBLIC_CALENDAR_EVENT_SYNC_CRON="*/10 * * * *"
PUBLIC_CALENDAR_SYNC_ON_BOOT=true
PUBLIC_CALENDAR_MAX_FEED_BYTES=8000000
PUBLIC_CALENDAR_MAX_EVENTS=5000
PUBLIC_CALENDAR_MAX_OCCURRENCES=10000
PUBLIC_CALENDAR_MAX_OCCURRENCES_PER_EVENT=750
PUBLIC_CALENDAR_MAX_SCANNED_OCCURRENCES=250000
PUBLIC_CALENDAR_MAX_TEXT_LENGTH=2000
PUBLIC_CALENDAR_LOOKBACK_DAYS=30
PUBLIC_CALENDAR_LOOKAHEAD_DAYS=180
PUBLIC_CALENDAR_STALE_AFTER_MINUTES=720
PUBLIC_CALENDAR_FALLBACK_TIME_ZONE=Europe/Berlin
PUBLIC_CALENDAR_USER_AGENT="CampusKoethen/1.2.4 (+https://api.example.org)"
PUBLIC_CALENDAR_API_MAX_CALENDARS=50
PUBLIC_CALENDAR_API_MAX_RANGE_DAYS=120

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=false
