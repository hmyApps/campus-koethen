<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/calendar_widget_background"
    android:contentDescription="@string/calendar_widget_title"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/calendar_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/calendar_widget_title"
        android:textColor="@color/calendar_widget_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/calendar_widget_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="3"
        android:text="@string/calendar_widget_disabled"
        android:textColor="@color/calendar_widget_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/calendar_widget_row_1"
        style="@style/CalendarWidgetRow">

        <TextView
            android:id="@+id/calendar_widget_time_1"
            style="@style/CalendarWidgetTime" />

        <TextView
            android:id="@+id/calendar_widget_event_1"
            style="@style/CalendarWidgetEvent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/calendar_widget_row_2"
        style="@style/CalendarWidgetRow">

        <TextView
            android:id="@+id/calendar_widget_time_2"
            style="@style/CalendarWidgetTime" />

        <TextView
            android:id="@+id/calendar_widget_event_2"
            style="@style/CalendarWidgetEvent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/calendar_widget_row_3"
        style="@style/CalendarWidgetRow">

        <TextView
            android:id="@+id/calendar_widget_time_3"
            style="@style/CalendarWidgetTime" />

        <TextView
            android:id="@+id/calendar_widget_event_3"
            style="@style/CalendarWidgetEvent" />
    </LinearLayout>

    <TextView
        android:id="@+id/calendar_widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/calendar_widget_secondary"
        android:textSize="10sp" />
</LinearLayout>
